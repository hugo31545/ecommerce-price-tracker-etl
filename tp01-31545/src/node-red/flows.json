        "name": "preços atuais",
        "func": "// Responde ao KNIME com os preços atuais da loja US\nconst precos = flow.get('precos') || [];\nmsg.payload = precos.map(p => ({\n    ean: p.ean,\n    name: p.name,\n    price: p.price_text || ('$' + p.price_usd),\n    shipping: p.shipping_text || ('$' + p.shipping_usd),\n    updated_at: p.updated_at || null\n}));\nreturn msg;",
