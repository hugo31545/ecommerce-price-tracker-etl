    {
        "id": "u_load",
        "type": "function",
        "z": "tp1tab",
        "name": "guardar preços base",
        "func": "// Guarda os preços base da loja US na memória do fluxo\nconst base = msg.payload;\nflow.set('precos', base.map(p => ({ ...p, price_usd_base: p.price_usd })));\nnode.status({ fill: 'green', shape: 'dot', text: base.length + ' produtos carregados' });\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 200,
        "wires": [
            []
        ]
    },
    {
        "id": "s_inj",
        "type": "inject",
        "z": "tp1tab",
        "name": "a cada 10 s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "10",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 120,
        "y": 260,
        "wires": [
            [
                "s_sim"
            ]
        ]
    },
    {
        "id": "s_sim",
        "type": "function",
        "z": "tp1tab",
        "name": "simular variação de preços",
        "func": "// Simula a variação de preços da loja US (a cada 10 s)\nconst precos = flow.get('precos');\nif (!precos) return null;\nconst agora = new Date().toISOString();\nfor (const p of precos) {\n    let fator = 1 + (Math.random() * 0.06 - 0.03);   // variação normal de ±3%\n    if (Math.random() < 0.05) fator = 0.85;           // 5% de hipótese de promoção relâmpago (-15%)\n    p.price_usd = Math.round(p.price_usd_base * fator * 100) / 100;\n    // formato americano, de propósito, para a Regex limpar no KNIME: $1,049.99\n    p.price_text = '$' + p.price_usd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    p.shipping_text = '$' + p.shipping_usd.toFixed(2);\n    p.updated_at = agora;\n}\nflow.set('precos', precos);\nmsg.payload = precos.map(p => ({ ean: p.ean, name: p.name, price: p.price_text, shipping: p.shipping_text, updated_at: p.updated_at }));\nnode.status({ fill: 'blue', shape: 'ring', text: 'atualizado ' + agora.substring(11, 19) });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 260,
        "wires": [
            [
                "s_dbg",
                "s_str"
            ]
        ]
